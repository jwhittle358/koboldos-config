# KoboldOS swaylock defaults — installed to /etc/swaylock/config by install.sh
image=@WALLPAPER@
scaling=fill
color=1d1d1f
indicator-radius=90
inside-color=0e0e0fdd
inside-clear-color=0e0e0fdd
inside-ver-color=0e0e0fdd
inside-wrong-color=3a0c0cdd
ring-color=7a5c26
ring-clear-color=8a7f6a
ring-ver-color=d6a03e
ring-wrong-color=a3241b
key-hl-color=e0a83f
bs-hl-color=a3241b
line-color=00000000
separator-color=00000000
text-color=cfc4ab
